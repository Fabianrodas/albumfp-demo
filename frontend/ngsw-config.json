{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationRequestStrategy": "freshness",
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/auth/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**"
  ],
  "assetGroups": [
    {
      "name": "shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/index.html", "/manifest.webmanifest", "/favicon.ico", "/theme-init.js", "/*.css", "/*.js"]
      }
    },
    {
      "name": "static",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/media/*.woff2", "/icons/*.png", "/logo.png", "/logo_white.png"]
      }
    }
  ]
}
