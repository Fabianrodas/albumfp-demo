# Copy this file to .env. setup.ps1 replaces the placeholders with fresh,
# machine-local passwords and a Flask session key.
APP_ENV=development
FLASK_SECRET_KEY=GENERATED_BY_SETUP
CORS_ORIGINS=http://localhost:4200
PUBLIC_ORIGIN=http://localhost:4200
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

DATABASE_URL=postgresql+psycopg2://albumfp_demo:GENERATED_BY_SETUP@127.0.0.1:55432/albumfp_demo
TEST_DATABASE_URL=postgresql+psycopg2://albumfp_demo:GENERATED_BY_SETUP@127.0.0.1:55432/albumfp_demo_test

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_USER=albumfp_demo
POSTGRES_PASSWORD=GENERATED_BY_SETUP
POSTGRES_ADMIN_USER=albumfp_demo_admin
POSTGRES_ADMIN_PASSWORD=GENERATED_BY_SETUP

MEDIA_STORAGE_ROOT=../../albumfp-demo-runtime/media
# Optional: require this local volume to be mounted before media writes.
# MEDIA_STORAGE_REQUIRED_MOUNTPOINT=
MEDIA_TMP_ROOT=../../albumfp-demo-runtime/tmp
MEDIA_QUARANTINE_ROOT=../../albumfp-demo-runtime/quarantine

DEV_HOST=127.0.0.1
DEV_PORT=5000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=4200
REGISTRATION_MODE=open
